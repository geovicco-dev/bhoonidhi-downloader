    family-names: Sharma
    alias: geovicco-dev
    orcid: "https://orcid.org/0009-0007-6154-086X"
repository-code: "https://github.com/geovicco-dev/bhoonidhi-downloader"
url: "https://geovicco-dev.github.io/bhoonidhi-downloader/"
license: MIT
keywords:
  - remote sensing
  - earth observation
  - satellite imagery
  - ISRO
  - Bhoonidhi
  - NRSC
  - GIS
  - python
version: 0.5.1
date-released: "2026-08-17"

